+@functools.lru_cache(maxsize=None)
+def _ift_kernels():
+  """Patch 0004's kernels, made on first use (with MJW_IFT_SOLVE unset this module's kernels are the original ones)."""
+
+  @wp.func
+  def rhs_scale(nv: int, adj_qacc: wp.array2d[float], worldid: int):
+    # the power of two s >= max |adj_qacc| (1 when that is at most 1): b / s and x s round exactly
+    amax = float(0.0)
+    for i in range(nv):
+      amax = wp.max(amax, wp.abs(adj_qacc[worldid, i]))
+    scale = float(1.0)
+    while scale < amax:
+      scale = 2.0 * scale
+    return scale
+
+  @wp.kernel(module="unique", enable_backward=False)
+  def load_rhs_scaled(nv: int, adj_qacc: wp.array2d[float], grad_out: wp.array2d[float]):
+    worldid, i = wp.tid()
+    if i < nv:
+      grad_out[worldid, i] = -adj_qacc[worldid, i] / rhs_scale(nv, adj_qacc, worldid)
+    else:
+      grad_out[worldid, i] = 0.0
+
+  @wp.kernel(module="unique", enable_backward=False)
+  def unscale_solution(
+    nv: int,
+    adj_qacc: wp.array2d[float],
+    grad: wp.array2d[float],
+    search: wp.array2d[float],
+    search_dot: wp.array[float],
+    newton_decrement: wp.array[float],
+  ):
+    worldid, i = wp.tid()
+    # the solve's outputs as the original's: grad = -adj_qacc, search = lam, search_dot and the decrement times s^2
+    scale = rhs_scale(nv, adj_qacc, worldid)
+    grad[worldid, i] = grad[worldid, i] * scale
+    search[worldid, i] = search[worldid, i] * scale
+    if i == 0:
+      search_dot[worldid] = search_dot[worldid] * scale * scale
+      newton_decrement[worldid] = newton_decrement[worldid] * scale * scale
+
+  @wp.kernel(module="unique", enable_backward=False)
+  def negate(x: wp.array2d[float], out: wp.array2d[float]):
+    worldid, i = wp.tid()
+    out[worldid, i] = -x[worldid, i]
+
+  return load_rhs_scaled, unscale_solution, negate
+
+
+def _solve_backward_ift(m: Model, d_out: Data, adj_qacc: wp.array, solver_ctx: SolverContext):
+  """Patch 0004 (MJW_IFT_SOLVE 1 or 2, nv > 32): the IFT solve without the augmented factorization's ceiling."""
+  load_rhs_scaled, unscale_solution, negate = _ift_kernels()
+  nworld = d_out.nworld
+  if IFT_SOLVE == 1:
+    wp.launch(load_rhs_scaled, dim=(nworld, m.nv_pad), inputs=[m.nv, adj_qacc], outputs=[solver_ctx.grad])
+    solver._cholesky_factorize_solve(m, d_out, solver_ctx)
+    wp.launch(
+      unscale_solution,
+      dim=(nworld, m.nv),
+      inputs=[m.nv, adj_qacc],
+      outputs=[solver_ctx.grad, solver_ctx.search, solver_ctx.search_dot, solver_ctx.newton_decrement],
+    )
+    return
+  # solves H x = -adj_qacc in place in grad (the factorization reads all of b before it writes x), lam = -x
+  wp.launch(_load_rhs, dim=(nworld, m.nv_pad), inputs=[m.nv, adj_qacc], outputs=[solver_ctx.grad])
+  grad = solver_ctx.grad.reshape(shape=(nworld, solver_ctx.grad.shape[1], 1))
+  wp.launch_tiled(
+    solver._cholesky_factorize_solve_blocked(TILE_SIZE_JTDAJ_DENSE, m.nv_pad),
+    dim=nworld,
+    inputs=[solver_ctx.h, grad],
+    outputs=[solver_ctx.hfactor, grad],
+    block_dim=m.block_dim.update_gradient_cholesky_blocked,
+  )
+  wp.launch(negate, dim=(nworld, m.nv), inputs=[solver_ctx.grad], outputs=[solver_ctx.search])
+
