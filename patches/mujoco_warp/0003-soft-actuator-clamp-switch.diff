+@wp.kernel(enable_backward=False)
+def _actuator_lam_soft(
+  # Model:
+  nu: int,
+  jnt_actfrclimited: wp.array[bool],
+  jnt_actgravcomp: wp.array[int],
+  jnt_actfrcrange: wp.array2d[wp.vec2],
+  dof_jntid: wp.array[int],
+  # Data in:
+  moment_rownnz_in: wp.array2d[int],
+  moment_rowadr_in: wp.array2d[int],
+  moment_colind_in: wp.array2d[int],
+  actuator_moment_in: wp.array2d[float],
+  actuator_force_in: wp.array2d[float],
+  qfrc_gravcomp_in: wp.array2d[float],
+  qfrc_actuator_in: wp.array2d[float],
+  # In:
+  gravity_enabled: bool,
+  clamp_soft: float,
+  lam: wp.array2d[float],
+  # Out:
+  lam_out: wp.array2d[float],
+):
+  """Patch 0003 (CLAMP_SOFT > 0): scales the multiplier on dofs whose joint actuator force is clamped by w.
+
+  The clamp test is _actuator_lam's. The unclamped force of the dof is the forward's (fwd_actuation): the actuators'
+  moment-weighted forces summed into the dof (_qfrc_actuator), plus the actuator-level gravity compensation, before the
+  actuatorfrcrange clamp (_qfrc_actuator_gravcomp_limits). o = (f - hi) / |hi| on the upper bound, (lo - f) / |lo| on the
+  lower, clipped at 0, and w = exp(-o / clamp_soft).
+  """
+  worldid, dofid = wp.tid()
+  value = lam[worldid, dofid]
+  jntid = dof_jntid[dofid]
+  if jnt_actfrclimited[jntid]:
+    frcrange = jnt_actfrcrange[worldid % jnt_actfrcrange.shape[0], jntid]
+    qfrc = qfrc_actuator_in[worldid, dofid]
+    if qfrc <= frcrange[0] or qfrc >= frcrange[1]:
+      f = float(0.0)
+      for actid in range(nu):
+        rowadr = moment_rowadr_in[worldid, actid]
+        for i in range(moment_rownnz_in[worldid, actid]):
+          if moment_colind_in[worldid, rowadr + i] == dofid:
+            f += actuator_moment_in[worldid, rowadr + i] * actuator_force_in[worldid, actid]
+      if gravity_enabled and jnt_actgravcomp[jntid]:
+        f += qfrc_gravcomp_in[worldid, dofid]
+      over = float(0.0)
+      if qfrc >= frcrange[1]:
+        over = (f - frcrange[1]) / wp.max(wp.abs(frcrange[1]), MJ_MINVAL)
+      else:
+        over = (frcrange[0] - f) / wp.max(wp.abs(frcrange[0]), MJ_MINVAL)
+      value = wp.exp(-wp.max(over, 0.0) / clamp_soft) * value
+  lam_out[worldid, dofid] = value
+
